{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tempo Timesheet Tool",
  "version": "0.4.0",
  "identifier": "com.dieselmitchell.tempotimesheettool",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tempo Timesheet Tool",
        "width": 1400,
        "height": 960,
        "minWidth": 520,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwMDRBM0UwQTY0QzkyMEMKUldRTWtreW00S01FRUU2b21YdGN4M01LSFh1Nm40c2dEZzlEd0g3RHBtc2NTM29qTnQ0RmR6RW8K",
      "endpoints": [
        "https://github.com/DieselFuel147/tempo-timesheet-notebook/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "publisher": "Diesel Mitchell",
    "shortDescription": "Local-first desktop timesheet logging for Jira and Tempo.",
    "longDescription": "Local-first desktop timesheet logging with native SQLite persistence, Jira lookup, Tempo dry run, and Tempo push orchestration.",
    "icon": [
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
