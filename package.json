{
  "name": "tempo-timesheet-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Structured day-at-a-glance time logging that pushes cleanly to Tempo via the API.",
  "scripts": {
    "dev": "NODE_USE_SYSTEM_CA=1 concurrently -n web,api -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "NODE_USE_SYSTEM_CA=1 tsx watch server/index.ts",
    "build": "vite build",
    "build:web": "vite build",
    "start": "NODE_USE_SYSTEM_CA=1 tsx server/index.ts",
    "smoke": "NODE_USE_SYSTEM_CA=1 tsx server/smoke.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fastify/static": "^9.3.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-date-pickers": "^9.9.0",
    "better-sqlite3": "^11.8.1",
    "dayjs": "^1.11.21",
    "dotenv": "^16.4.7",
    "fastify": "^5.10.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@tauri-apps/cli": "^2.8.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
