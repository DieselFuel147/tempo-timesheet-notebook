# Jira and Tempo credentials are NOT read from the environment. Enter them in
# the app's Settings screen — they are stored in the OS keychain via the native
# Tauri secret store, not in this file.

# --- Frontend dev knobs (optional) ---
# Speeds up the notebook time scale during local UI development. Leave unset
# (defaults to 1) for real usage.
VITE_NOTEBOOK_TIME_SCALE=1
