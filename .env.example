# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# --- Jira Cloud (Basic auth: your email + an Atlassian API token) ---
# Needed to translate ticket keys (REACT-1540) into the numeric issue IDs
# Tempo requires, to read your accountId, and to power ticket autocomplete.
# Create a token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# --- Tempo (Bearer token) ---
# Create under Tempo > Settings > API integration.
TEMPO_BASE_URL=https://api.tempo.io/4
TEMPO_API_TOKEN=

# --- Server ---
# Port for the Fastify backend. The Vite dev UI proxies /api to it.
API_PORT=3000
